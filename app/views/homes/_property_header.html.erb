<header>
  <%= link_to "Homes", homes_path, class: "text-sm font-medium text-muted-foreground hover:text-foreground" %>

  <p class="mt-7 text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">Welcome home</p>
  <h1 class="mt-3 text-5xl font-semibold leading-none text-foreground sm:text-6xl"><%= home.name %></h1>

  <div class="mt-3 flex flex-wrap items-center gap-2 text-base leading-relaxed text-muted-foreground">
    <% if home.address.present? %>
      <p><%= home.address %></p>
    <% end %>

    <% if home.home_type.present? %>
      <span class="rounded-full bg-primary-soft px-2.5 py-0.5 text-sm font-medium text-accent-foreground"><%= home.home_type.humanize %></span>
    <% end %>
  </div>
</header>
