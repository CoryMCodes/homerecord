<% content_for :title, @home.name %>

<section>
  <%= render "property_header", home: @home %>

  <%= render "stat_group",
    entries_count: @timeline_entries.size,
    items_count: @home.items.size,
    last_activity_label: (@timeline_entries.first&.occurred_on&.strftime("%b %-d") || "None") %>

  <div class="relative z-20" data-controller="search-panel" data-action="keydown.esc->search-panel#close click@window->search-panel#closeOnOutsideClick">
    <%= render(Ui::SearchFieldComponent.new(
      url: home_search_path(@home),
      value: params[:q],
      placeholder: "Search entries, items, and files...",
      turbo_frame: "home_search_results",
      form_data: { search_panel_target: "form" },
      input_data: {
        search_panel_target: "input",
        action: "input->search-panel#queueSearch focus->search-panel#openIfPresent"
      }
    )) %>

    <div class="absolute left-0 right-0 top-full z-30 mt-2 hidden" data-search-panel-target="panel">
      <%= turbo_frame_tag "home_search_results" %>
    </div>
  </div>

  <%= render(Ui::FilterNavComponent.new(
    label: "Timeline filters",
    items: @timeline_filter_items
  )) %>

  <%= render(Entries::TimelineComponent.new(entries: @timeline_entries, home: @home)) %>

  <nav aria-label="Home item actions" class="mt-8 flex flex-wrap gap-3">
    <%= render(Ui::ButtonComponent.new(href: home_items_path(@home), variant: :secondary)) do %>
      View items
    <% end %>

    <%= render(Ui::ButtonComponent.new(href: new_home_item_path(@home), variant: :ghost)) do %>
      Add item
    <% end %>

    <%= render(Ui::ButtonComponent.new(href: new_home_entry_path(@home), variant: :ghost)) do %>
      Add entry
    <% end %>
  </nav>

  <%= render(Ui::FloatingActionComponent.new(href: new_home_entry_path(@home), label: "Add entry")) %>
</section>
