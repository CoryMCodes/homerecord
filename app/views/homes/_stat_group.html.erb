<div class="mt-7 flex items-center gap-7 border-t border-border pt-5" aria-label="Home record summary">
  <div class="flex flex-col gap-0.5">
    <span class="text-2xl font-semibold leading-none tabular-nums"><%= entries_count %></span>
    <span class="text-sm text-muted-foreground">Entries</span>
  </div>

  <span class="h-9 w-px bg-border" aria-hidden="true"></span>

  <div class="flex flex-col gap-0.5">
    <span class="text-2xl font-semibold leading-none tabular-nums"><%= items_count %></span>
    <span class="text-sm text-muted-foreground">Items</span>
  </div>

  <span class="h-9 w-px bg-border" aria-hidden="true"></span>

  <div class="flex min-w-0 flex-col gap-0.5">
    <span class="truncate text-2xl font-semibold leading-none tabular-nums"><%= last_activity_label %></span>
    <span class="text-sm text-muted-foreground">Latest</span>
  </div>
</div>
