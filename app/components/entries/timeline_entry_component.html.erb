<li>
  <article class="group relative flex w-full gap-4 rounded-2xl p-3.5 transition-all duration-200 hover:bg-card hover:shadow-card motion-reduce:transition-none">
    <span class="relative z-10 mt-0.5 flex size-11 shrink-0 items-center justify-center rounded-full bg-primary text-xl text-primary-foreground shadow-sm ring-[3px] ring-background" aria-hidden="true">
      <%= category_label.first %>
    </span>

    <div class="min-w-0 flex-1 pb-1">
      <div class="flex items-baseline justify-between gap-3">
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-primary"><%= category_label %></p>
        <time datetime="<%= entry.occurred_on.iso8601 %>" class="shrink-0 text-sm font-medium tabular-nums text-muted-foreground"><%= short_date %></time>
      </div>

      <h3 class="mt-1.5 text-lg font-semibold leading-snug text-foreground">
        <%= link_to entry.title, home_entry_path(entry.home, entry), class: "hover:text-primary" %>
      </h3>

      <% if entry.description.present? %>
        <p class="mt-1 text-base leading-relaxed text-muted-foreground"><%= entry.description %></p>
      <% end %>

      <%= render Ui::MetadataRowComponent.new(items: metadata_items) %>
    </div>

    <span aria-hidden="true" class="mt-3 shrink-0 self-start text-lg text-muted-foreground/50 transition-transform group-hover:translate-x-0.5 motion-reduce:transition-none">›</span>
  </article>
</li>
