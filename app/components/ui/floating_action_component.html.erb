<div class="pointer-events-none fixed inset-x-0 bottom-7 z-30 flex justify-center px-5">
  <%= link_to href, aria: { label: label }, class: "pointer-events-auto inline-flex items-center gap-2 rounded-full bg-primary px-5 py-3.5 text-base font-semibold text-primary-foreground shadow-floating ring-1 ring-black/5 transition-[background-color,transform] duration-200 hover:bg-primary-hover active:scale-[0.97] motion-reduce:transition-none motion-reduce:active:scale-100" do %>
    <span aria-hidden="true" class="text-2xl leading-none"><%= symbol %></span>
    <span><%= label %></span>
    <span class="sr-only"><%= label %></span>
  <% end %>
</div>
