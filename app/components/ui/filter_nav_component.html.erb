<nav aria-label="<%= label %>" class="mt-4 -mx-5 overflow-x-auto px-5">
  <ul class="flex items-center gap-1.5 pb-1">
    <% items.each do |item| %>
      <li>
        <%= link_to item[:label], item[:href], class: item_classes(item), aria: ({ current: "page" } if item[:active]) %>
      </li>
    <% end %>
  </ul>
</nav>
